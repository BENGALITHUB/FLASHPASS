{
  "name": "ticket-booking-system",
  "version": "2.0.0",
  "description": "3-Day Comics Carnival — Ticketing & Gate Control System",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "start:server": "npm --prefix server run start",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "test": "npm --prefix server test",
    "loadtest": "npm --prefix server run loadtest",
    "prod:start": "pm2 start ecosystem.config.cjs",
    "prod:restart": "pm2 restart flashpass --update-env",
    "prod:stop": "pm2 stop flashpass",
    "prod:logs": "pm2 logs flashpass"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
