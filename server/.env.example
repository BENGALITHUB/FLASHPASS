PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://admin:YOUR_DB_PASSWORD_HERE@cluster0.jrmbk.mongodb.net/comics-carnival?retryWrites=true&w=majority

# Secrets: generate each one, never copy them from anywhere:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start in production if these are missing, short or public.

# HMAC secret for signing pass QR codes (>= 32 chars)
QR_HMAC_SECRET=
QR_KEY_VERSION=CC1
# When rotating: move the old values here so passes already sold keep working
# QR_KEY_VERSION_PREVIOUS=CC1
# QR_HMAC_SECRET_PREVIOUS=

# Secret for staff login tokens (>= 32 chars). Changing it logs all staff out.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# PIN given to the first "admin" account when the database is empty.
# Change every demo PIN in Admin > Staff before the event.
DEFAULT_ADMIN_PIN=

# Simulated "instant approval" payments for local testing only.
# Ignored when NODE_ENV=production. Never set this on a live server.
# ALLOW_MOCK_PAYMENTS=true

# Set to 1 when running behind nginx / cPanel / a load balancer, so rate limits
# use each visitor's real IP instead of the proxy's
# TRUST_PROXY=1
