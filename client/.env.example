# Optional client settings — copy to .env and fill in. Leave blank to disable.

# Public site origin, used for absolute share-preview (og:image) URLs. e.g. https://flashpass.in
VITE_SITE_URL=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (tracks page views, leads and purchases)
VITE_GA_ID=

# WhatsApp community invite link; shows a "Join our community" card in the footer
VITE_WHATSAPP_COMMUNITY_URL=
